{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Verified user identity profile synced upon Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address",
          "minLength": 3,
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "description": "Display name",
          "minLength": 1,
          "maxLength": 100
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication provider identifier",
          "enum": ["google"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp"
        }
      },
      "required": ["uid", "email", "name", "authProvider", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user identity profile indexed by Firebase Auth UID (owner or verified admin only)."
    }
  }
}
